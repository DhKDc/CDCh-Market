NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-ANON-KEY

# SECRETA: solo para el servidor (resetear contraseñas desde /admin).
# NUNCA le pongas el prefijo NEXT_PUBLIC_ ni la subas a GitHub.
# Supabase -> Project Settings -> API -> "service_role" key.
SUPABASE_SERVICE_ROLE_KEY=TU-SERVICE-ROLE-KEY

# Opcional: dominio del correo interno que arma la app a partir del usuario
# (nadie lo recibe). Solo defínelo si Supabase rechaza el dominio por defecto
# ("Email address ... is invalid"): usa un dominio tuyo.
# NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=tudominio.cl
